SERVICE_NAME=auth
SERVICE_ENV=local
SERVICE_PORT=8080

DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=auth-db

JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Куки токенов. Secure=true — дефолт; выключайте только для локальной отладки по http.
COOKIE_SECURE=false
COOKIE_DOMAIN=
# Внешний префикс сервиса за gateway (nginx публикует /api/auth/v1/** -> /api/v1/**).
# При прямом доступе без gateway задайте /api.
COOKIE_PATH_PREFIX=/api/auth

# Промежуточный токен второго фактора. Не короче AUTH_CODE_TTL.
JWT_MFA_TTL=10m

# Одноразовые коды (подтверждение почты, второй фактор).
AUTH_CODE_TTL=10m
AUTH_CODE_RESEND_COOLDOWN=60s
AUTH_CODE_MAX_ATTEMPTS=5

# SMTP. Пустой SMTP_HOST — поддерживаемый режим `go run` без docker compose:
# сервис поднимется, а коды будут писаться в лог вместо отправки.
# Через docker compose сюда подставляется контейнер mailpit (UI на :8025).
SMTP_HOST=
SMTP_PORT=1025
# none | starttls | tls. none допустим только для локального mailpit.
SMTP_TRANSPORT=none
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@nexus.local
SMTP_FROM_NAME=Nexus
SMTP_TIMEOUT=5s
