SERVICE_NAME=auth
SERVICE_ENV=local
SERVICE_PORT=8080

DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=auth-db

# --- JWT signing (RS256) ---
# Generate a keypair first:  go run ./cmd/genkey -out ./secrets
# The private key stays here; jwt_public.pem is distributed to consumers
# (trading-backend, keys-service) which verify tokens offline.
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
# Comma-separated extra public keys kept valid for verification during a
# no-downtime key rotation (optional).
JWT_ADDITIONAL_PUBLIC_KEY_PATHS=

# Claims. Must stay stable across environments — consumers hardcode them.
JWT_ISSUER=sleipnir-auth
JWT_AUDIENCE=trading-backend,keys-service

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
