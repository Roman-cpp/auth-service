SERVICE_NAME=auth
SERVICE_ENV=local
SERVICE_PORT=8080

DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=auth-db

JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Куки токенов. Secure=true — дефолт; выключайте только для локальной отладки по http.
COOKIE_SECURE=false
COOKIE_DOMAIN=
# Внешний префикс сервиса за gateway (nginx публикует /api/auth/v1/** -> /api/v1/**).
# При прямом доступе без gateway задайте /api.
COOKIE_PATH_PREFIX=/api/auth
