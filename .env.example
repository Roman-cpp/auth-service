# Скопируйте этот файл в .env и заполните значения
# cp .env.example .env

# Сервер
SERVER_PORT=8080

# База данных (можно использовать DATABASE_URL или отдельные параметры)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/authdb?sslmode=disable
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=authdb

# JWT — ОБЯЗАТЕЛЬНО смените секрет перед деплоем!
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
