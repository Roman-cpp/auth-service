SERVICE_NAME=auth
SERVICE_ENV=local
SERVICE_PORT=8080

DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=auth-db

JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Куки токенов. Secure=true — дефолт; выключайте только для локальной отладки по http.
COOKIE_SECURE=false
COOKIE_DOMAIN=
# Внешний префикс сервиса за gateway (nginx публикует /api/auth/v1/** -> /api/v1/**).
# При прямом доступе без gateway задайте /api.
COOKIE_PATH_PREFIX=/api/auth

# Промежуточный токен второго фактора. Не короче AUTH_CODE_TTL.
JWT_MFA_TTL=10m

# Одноразовые коды (подтверждение почты, второй фактор).
AUTH_CODE_TTL=10m
AUTH_CODE_RESEND_COOLDOWN=60s
AUTH_CODE_MAX_ATTEMPTS=5

# Срок жизни QR-кода входа. Не больше AUTH_CODE_TTL.
AUTH_QR_TTL=2m

# Сколько удалённый аккаунт можно восстановить. По истечении окна строка
# удаляется физически, и адрес освобождается окончательно. Уменьшать на живом
# сервисе опасно: часть аккаунтов станет невосстановимой немедленно.
ACCOUNT_RESTORE_WINDOW=8760h

# Письма с кодами. http — через mail-service подписанным запросом: обязательны
# MAIL_SERVICE_URL (https вне SERVICE_ENV=local) и MAIL_SECRET (≥32 символов —
# секрет клиента auth из MAIL_API_KEYS почтовика). log — коды пишутся в лог:
# режим `go run` без почтовика, разрешён только для SERVICE_ENV=local.
# SMTP у auth-service нет — он настраивается у mail-service.
MAIL_TRANSPORT=log
MAIL_SERVICE_URL=http://localhost:8081
MAIL_CLIENT_ID=auth
MAIL_SECRET=
MAIL_TIMEOUT=5s
